{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResolveSceneMarkerManifest",
  "description": "剧本场景与达芬奇时间线标记清单规范",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "episode", "slugline", "start", "end", "duration", "asset"],
    "properties": {
      "id": {
        "type": "string",
        "description": "场景唯一标识符，格式如 EP002_01"
      },
      "episode": {
        "type": "integer",
        "description": "集数编号"
      },
      "scene_name": {
        "type": "string",
        "description": "剧本场景标题"
      },
      "slugline": {
        "type": "string",
        "description": "规范化 Slugline（内外景 · 场景名 · 昼夜）"
      },
      "setting": {
        "type": "string",
        "enum": ["内景", "外景", "异空间", "功法幻境", "车内", "内外景"]
      },
      "daypart": {
        "type": "string",
        "enum": ["日", "夜", "黄昏", "黎明", "无昼夜"]
      },
      "story": {
        "type": "string",
        "description": "一句话剧情概要"
      },
      "asset": {
        "type": "string",
        "description": "美术概念设计图绝对路径"
      },
      "basis": {
        "type": "string",
        "description": "时段与光照判定依据"
      },
      "start": {
        "type": "integer",
        "description": "时间线起始帧（绝对帧或相对帧）"
      },
      "end": {
        "type": "integer",
        "description": "时间线结束帧"
      },
      "duration": {
        "type": "integer",
        "description": "持续总帧数"
      },
      "marker_name": {
        "type": "string",
        "description": "显示在 Resolve 标记上的名称"
      },
      "marker_note": {
        "type": "string",
        "description": "显示在 Resolve 标记浮窗中的详细内容"
      }
    }
  }
}
